# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/scripts

# Jarvis file-operation backups and organize undo manifests
/data/fs-journal/

# Semantic memory vector cache (regenerated from data/memories.json)
/data/memory-vectors.json
/data/memory-vectors.json.tmp

# Jarvis runtime state (reminders, autostart log, session recaps, topic monitors, wake word models, keyboard portal token)
/data/reminders.json
/data/reminders.json.tmp
/data/autostart.log
/data/sessions.json
/data/monitors.json
/data/wakeword/
/data/portal-token.json

/Mark-LIII/